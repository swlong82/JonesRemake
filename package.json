{
  "name": "hustle-ring-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Modern browser remake of a 1991 life-sim board game. Working title: Hustle Ring.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build && pnpm budget",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage && pnpm content:validate",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "tsx packages/content/cli/validate.ts --all",
    "gen:types": "tsx tools/gen-command-types.ts",
    "sim": "tsx packages/sim/cli.ts",
    "sim:smoke": "tsx packages/sim/cli.ts --games 200 --seats 2 --ai normal,normal --goals 50",
    "sim:gate": "tsx packages/sim/cli.ts --config sim/gates.json --assert",
    "baseline": "tsx tools/baseline-report.ts && prettier --write --log-level warn BASELINE_REPORT.md reports/baseline.json",
    "check:banned": "tsx tools/check-banned.ts",
    "art:check": "tsx tools/art-check.ts",
    "art:placeholders": "tsx tools/art-placeholders.ts && prettier --write --log-level warn packages/art/sets",
    "art:draw": "tsx tools/art-draw.ts",
    "scaffold:check": "tsx tools/scaffold-check.ts",
    "budget": "tsx tools/bundle-budget.ts --max-gzip-kb 350 --max-art-kb 1536",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm gen:types --check && pnpm check:banned && pnpm art:check && pnpm scaffold:check && pnpm build && pnpm test:e2e && pnpm sim:gate",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^21",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "6.2.4",
    "fast-check": "^4.10.1",
    "fast-glob": "^3.3.3",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "type": "module"
}
