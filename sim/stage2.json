{
  "$comment": "BALANCE_SPEC 9.5/9.6 stage-2 suite for `modern-western`: the measurement run behind each locked target in reports/modern-targets.json. Config ids match the `config` field there. Game counts are reduced from 10,000 (ADR-0016) and sized so one iteration fits a working session; `sim/gates.json` re-states the passing targets at CI sample sizes. The Normal x2 configs pit one personality against itself, so `firstSeatWinPct` measures turn order alone rather than the personality rotation (M6.3 iteration 7). Goals-100 modern games run long (~50 s each), so that config keeps the smallest sample the median can be read from (ADR-0016).",
  "gamesPerConfig": 120,
  "configs": [
    {
      "id": "modern-30-normal-2",
      "pack": "modern-western",
      "seats": 2,
      "ai": "normal:balanced,normal:balanced",
      "goals": 30,
      "chaos": "modern",
      "games": 120,
      "asserts": {
        "length.median": {
          "min": 22,
          "max": 34,
          "note": "9.5 median within ±20% of B=28"
        }
      }
    },
    {
      "id": "modern-50-normal-2",
      "pack": "modern-western",
      "seats": 2,
      "ai": "normal:balanced,normal:balanced",
      "goals": 50,
      "chaos": "modern",
      "games": 200,
      "asserts": {
        "length.median": {
          "min": 32,
          "max": 48,
          "note": "9.5 median within ±20% of B=40"
        },
        "stallRate": {
          "max": 0.5,
          "note": "9.5 stall < 0.5%"
        },
        "firstSeatWinPct": {
          "min": 45,
          "max": 55,
          "note": "9.5 seat bias 45–55%"
        },
        "lastGoalPct.wealth": {
          "min": 10,
          "note": "9.5 each goal last ≥ 10%"
        },
        "lastGoalPct.happiness": {
          "min": 10,
          "note": "9.5 each goal last ≥ 10%"
        },
        "lastGoalPct.education": {
          "min": 10,
          "note": "9.5 each goal last ≥ 10%"
        },
        "lastGoalPct.career": {
          "min": 10,
          "note": "9.5 each goal last ≥ 10%"
        },
        "collapseGamePct": {
          "min": 15,
          "max": 40,
          "note": "9.5 Normal AI collapse 15–40%"
        }
      }
    },
    {
