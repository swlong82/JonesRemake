{
  "$comment": "CI gate suite (BALANCE_SPEC 9.7). Classic keeps the 9.3 sanity gates it has had since M3.4; `modern-western` adds the 9.5 stage-2 gates at M6.4. gamesPerConfig is reduced from 500 to fit the 8-minute CI budget at ~1 s/game (ADR-0016) and every tolerance is widened by ±3 points for the smaller sample. A target `modern-targets.json` locks but the game does not yet meet is asserted with `pending` (ADR-0019) so the run prints it and `--strict` fails on it.",
  "gamesPerConfig": 120,
  "configs": [
    {
      "id": "classic-30-normal-2",
      "pack": "classic",
      "seats": 2,
      "ai": "normal,normal",
      "goals": 30,
      "games": 80,
      "asserts": {
        "stallRate": {
          "max": 2,
          "note": "9.3 stall < 0.5% widened for sample size"
        }
      }
    },
    {
      "id": "classic-50-normal-2",
      "pack": "classic",
      "seats": 2,
      "ai": "normal,normal",
      "goals": 50,
      "games": 120,
      "asserts": {
        "stallRate": {
          "max": 2,
          "note": "9.3 stall < 0.5% widened for sample size"
        },
        "lastGoalPct.wealth": {
          "min": 5,
          "note": "9.3 each goal last ≥ 10% (widened)"
        },
        "lastGoalPct.education": {
          "min": 5,
          "note": "9.3 each goal last ≥ 10% (widened)"
        },
        "lastGoalPct.career": {
          "min": 5,
          "note": "9.3 each goal last ≥ 10% (widened); met by continuous-employment tenure (ADR-0040)"
        },
        "lastGoalPct.happiness": {
          "min": 5,
          "note": "9.3 each goal last ≥ 10% (widened); ADR-0025 happiness decay"
        }
      }
    },
    {
      "id": "seatbias-classic-50-normal-2",
      "pack": "classic",
      "seats": 2,
      "ai": "normal:balanced,normal:balanced",
      "goals": 50,
      "games": 120,
      "seedBase": "gate-seatbias-classic-50",
      "asserts": {
        "firstSeatWinPct": {
          "min": 38,
          "max": 62,
          "note": "9.3 seat bias 45–55% ± sampling; one personality against itself, so this is turn order alone (ADR-0044)"
        }
      }
    },
    {
      "id": "classic-80-normal-2",
      "pack": "classic",
      "seats": 2,
      "ai": "normal,normal",
      "goals": 80,
      "games": 80,
      "asserts": {
        "stallRate": {
          "max": 5
        }
      }
    },
    {
      "id": "classic-100-normal-2",
      "pack": "classic",
      "seats": 2,
      "ai": "normal,normal",
      "goals": 100,
      "games": 80,
      "asserts": {
        "stallRate": {
          "max": 10
        },
        "winnerAllDegreesPct": {
          "min": 99,
          "note": "9.3 education-only path completes in stall-free games"
        }
      }
    },
    {
      "id": "classic-50-hard-vs-easy",
      "pack": "classic",
      "seats": 2,
      "ai": "hard,easy",
      "goals": 50,
      "games": 32,
      "asserts": {
        "winnerDifficultyPct.hard": {
          "min": 77,
          "note": "9.3 Hard wins ≥ 80%, widened ±3 points"
        }
      }
    },
    {
      "id": "classic-50-easy-vs-hard",
      "pack": "classic",
      "seats": 2,
      "ai": "easy,hard",
      "goals": 50,
      "games": 32,
      "asserts": {
        "winnerDifficultyPct.hard": {
          "min": 77,
          "note": "9.3 Hard wins ≥ 80% (seats swapped), widened ±3 points"
        }
      }
    },
    {
      "id": "classic-50-normal-4",
      "pack": "classic",
      "seats": 4,
      "ai": "normal,normal,normal,normal",
      "goals": 50,
      "games": 48,
      "asserts": {
        "stallRate": {
          "max": 5
        },
        "firstSeatWinPct": {
          "min": 12,
          "max": 38,
          "note": "4 seats: 25% ± sampling"
        }
      }
    },
    {
      "id": "classic-50-bots",
      "pack": "classic",
      "seats": 2,
      "ai": "bot:StudyFirst,normal",
      "goals": 50,
      "games": 48,
      "asserts": {
        "botWinPct.StudyFirst": {
          "max": 63,
          "note": "9.5 no bot beats Normal Balanced > 60%, widened ±3 points"
        }
      }
    },
    {
      "id": "modern-30-normal-2",
      "pack": "modern-western",
      "seats": 2,
      "ai": "normal:balanced,normal:balanced",
      "goals": 30,
      "chaos": "modern",
      "games": 60,
      "asserts": {
        "length.median": {
          "min": 16,
          "max": 32,
          "note": "9.5 median within ±20% of classic B=24 (19–29, ADR-0048), widened ±3 weeks"
        },
        "stallRate": {
          "max": 2
        }
      }
    },
    {
      "id": "modern-50-normal-2",
      "pack": "modern-western",
      "seats": 2,
      "ai": "normal:balanced,normal:balanced",
      "goals": 50,
      "chaos": "modern",
      "games": 120,
      "asserts": {
        "length.median": {
          "min": 23,
          "max": 43,
          "note": "9.5 median within ±20% of classic B=33 (26–40, ADR-0048), widened ±3 weeks"
        },
        "stallRate": {
          "max": 2,
          "note": "9.5 stall < 0.5% widened for sample size"
        },
        "firstSeatWinPct": {
          "min": 38,
          "max": 62,
          "note": "9.5 seat bias 45–55% ± sampling; one personality against itself, so this is turn order alone"
        },
        "lastGoalPct.happiness": {
          "min": 5,
          "note": "9.5 each goal last ≥ 10% (widened)"
        },
        "lastGoalPct.education": {
          "min": 5,
          "note": "9.5 each goal last ≥ 10% (widened)"
        },
        "lastGoalPct.wealth": {
          "min": 5,
          "note": "9.5 each goal last ≥ 10% (widened); met by ADR-0040"
        },
        "lastGoalPct.career": {
          "min": 5,
          "note": "9.5 each goal last ≥ 10% (widened); met by ADR-0040"
        },
        "collapseGamePct": {
          "min": 12,
          "max": 43,
          "note": "9.5 Normal AI collapse 15–40%, widened ±3 points; met by the Normal wellbeing weight and wellbeing profile (ADR-0049)"
        }
      }
    },
    {
      "id": "modern-50-hard-vs-easy",
      "pack": "modern-western",
      "seats": 2,
      "ai": "hard,easy",
      "goals": 50,
      "chaos": "modern",
      "games": 32,
      "asserts": {
        "winnerDifficultyPct.hard": {
          "min": 77,
          "note": "9.5 Hard wins ≥ 80%, widened ±3 points"
        }
      }
    },
    {
      "id": "modern-50-bot-GigOnly",
      "pack": "modern-western",
      "seats": 2,
      "ai": "bot:GigOnly,normal:balanced",
      "goals": 50,
      "chaos": "modern",
      "games": 40,
      "asserts": {
        "botWinPct.GigOnly": {
          "max": 28,
          "note": "9.5 GigOnly win rate < 25%, widened ±3 points"
        }
      }
    },
    {
      "id": "modern-50-bot-CryptoAllIn",
      "pack": "modern-western",
      "seats": 2,
      "ai": "bot:CryptoAllIn,normal:balanced",
      "goals": 50,
      "chaos": "modern",
      "games": 40,
      "asserts": {
        "botBankruptcyPct.CryptoAllIn": {
          "min": 37,
          "note": "9.5 bankruptcy > 40%, widened ±3 points"
        },
        "botWinPct.CryptoAllIn": {
          "min": 10,
          "max": 48,
          "note": "9.5 win rate 15–40%; widened further than ±3 points because 40 games is one bot seat per game — the 60-game stage-2 measurement reads 27% (ADR-0049)"
        }
      }
    },
    {
      "id": "modern-50-bot-StudyFirst",
      "pack": "modern-western",
      "seats": 2,
      "ai": "bot:StudyFirst,normal:balanced",
      "goals": 50,
      "chaos": "modern",
      "games": 40,
      "asserts": {
        "botWinPct.StudyFirst": {
          "max": 63,
          "note": "9.5 no bot beats Normal Balanced > 60%, widened ±3 points"
        }
      }
    },
    {
      "id": "modern-50-bot-NoRelax",
      "pack": "modern-western",
      "seats": 2,
      "ai": "bot:NoRelax,normal:balanced",
      "goals": 50,
      "chaos": "modern",
      "games": 40,
      "asserts": {
        "botCollapsePct.NoRelax": {
          "min": 57,
          "note": "9.5 ≥ 60% of games have ≥ 1 collapse, widened ±3 points"
        },
        "botWinPct.NoRelax": {
          "max": 63,
          "note": "9.5 no bot beats Normal Balanced > 60%, widened ±3 points"
        }
      }
    },
    {
      "id": "modern-50-bot-LoanMax",
      "pack": "modern-western",
      "seats": 2,
      "ai": "bot:LoanMax,normal:balanced",
      "goals": 50,
      "chaos": "modern",
      "games": 40,
      "asserts": {
        "botDefaultPct.LoanMax": {
          "min": 17,
          "max": 63,
          "note": "9.5 default rate 20–60%, widened ±3 points; met once the AI keeps two instalments liquid (ADR-0049)"
        },
        "botWinPct.LoanMax": {
          "max": 63,
          "note": "9.5 no bot beats Normal Balanced > 60%, widened ±3 points"
        }
      }
    },
    {
      "id": "modern-50-chaos",
      "pack": "modern-western",
      "seats": 2,
      "ai": "normal:balanced,normal:balanced",
      "goals": 50,
      "chaos": "modern",
      "games": 40,
      "seedBase": "gate-modern-chaos",
      "asserts": {
        "eventsPer100PlayerWeeks.ai-layoffs": {
          "min": 1,
          "note": "9.5 every modern family fires ≥ 1 per 100 player-weeks at Chaos Modern"
        },
        "eventsPer100PlayerWeeks.scams": {
          "min": 1,
          "note": "9.5 every modern family fires ≥ 1 per 100 player-weeks at Chaos Modern"
        },
        "eventsPer100PlayerWeeks.viral": {
          "min": 1,
          "note": "9.5 every modern family fires ≥ 1 per 100 player-weeks at Chaos Modern; met once the AI valued gadgets (ADR-0039)"
        },
        "eventsPer100PlayerWeeks.gadget-breakdown": {
          "min": 1,
          "note": "9.5 every modern family fires ≥ 1 per 100 player-weeks at Chaos Modern; met once the AI valued gadgets (ADR-0039)"
        }
      }
    }
  ],
  "compare": [
    {
      "id": "median-30<50",
      "left": "classic-30-normal-2.length.median",
      "right": "classic-50-normal-2.length.median",
      "op": "<",
      "note": "9.3 median grows with goal level"
    },
    {
      "id": "median-50<80",
      "left": "classic-50-normal-2.length.median",
      "right": "classic-80-normal-2.length.median",
      "op": "<",
      "note": "9.3 median grows with goal level"
    },
    {
      "id": "median-80<100",
      "left": "classic-80-normal-2.length.median",
      "right": "classic-100-normal-2.length.median",
      "op": "<",
      "note": "9.3 median grows with goal level"
    },
    {
      "id": "modern-median-30<50",
      "left": "modern-30-normal-2.length.median",
      "right": "modern-50-normal-2.length.median",
      "op": "<",
      "note": "9.5 median grows with goal level"
    }
  ]
}
