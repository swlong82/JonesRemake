{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "node_modules/.tmp/root-types",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node"],
    "module": "ESNext",
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.live.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["node_modules"]
}
